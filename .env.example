# --- Bot de Telegram ---
TELEGRAM_BOT_TOKEN=

# --- LLM local (LM Studio, igual que el huerto) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.5-4b
LLM_API_KEY=lm-studio
MAX_HISTORY_TURNS=4
REQUEST_TIMEOUT_S=60

# --- Bus de comunicación (motor_bus.py, TCP/JSON, no WebSocket) ---
BUS_HOST=127.0.0.1
BUS_PORT=8770
BUS_TIMEOUT_S=3

# --- MongoDB Atlas ---
# mongodb+srv://usuario:password@cluster.mongodb.net
MONGO_URI=
MONGO_DB=motor_qet
MONGO_COLLECTION=motor_telemetria
EVENTOS_COLLECTION=control_eventos
TELEMETRY_STALE_SECONDS=10

WHISPER_MODEL_SIZE=medium

WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

PIPER_VOICE_PATH=piper-voices/es_MX-claude-high.onnx
